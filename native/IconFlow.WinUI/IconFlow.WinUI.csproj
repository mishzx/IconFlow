<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>IconFlow</AssemblyName>
    <RootNamespace>IconFlow</RootNamespace>
    <Version>0.8.1</Version>
    <FileVersion>0.8.1.0</FileVersion>
    <Product>IconFlow 原生图标管理器</Product>
    <Company>IconFlow</Company>
    <ApplicationIcon>..\..\assets\icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.3.6" />
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" Version="2.1.6" />
    <PackageReference Include="Microsoft.WindowsAppSDK.DWrite" Version="2.1.0" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" Version="2.4.0" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" PrivateAssets="all" />
    <ProjectReference Include="..\IconFlow.Core\IconFlow.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PRIResource Remove="Strings\**\*.resw" />
    <Content Include="Strings\**\Resources.resw" Link="Strings\%(RecursiveDir)Resources.resw" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\assets\icon.png" Link="Assets\icon.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\assets\icon.ico" Link="Assets\icon.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\assets\builtin-icons\generated\**\*" Link="Assets\BuiltinIcons\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\README.md" Link="README.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="CopyWinUiResourcesToPublish" AfterTargets="Publish">
    <ItemGroup>
      <_WinUiPublishResource Include="$(TargetDir)*.xbf" />
      <_WinUiPublishResource Include="$(TargetDir)*.pri" />
    </ItemGroup>
    <Copy SourceFiles="@(_WinUiPublishResource)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
    <MakeDir Directories="$(PublishDir)Microsoft.UI.Xaml\Assets" />
  </Target>
</Project>
