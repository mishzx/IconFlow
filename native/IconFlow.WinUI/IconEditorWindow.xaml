<Window
    x:Class="IconFlow.IconEditorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:IconFlow">
    <Window.SystemBackdrop><MicaBackdrop Kind="BaseAlt"/></Window.SystemBackdrop>
    <Grid x:Name="Root">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TitleBar x:Name="AppTitleBar" Title="{local:Loc Key=EditorTitleBar.Title}" Subtitle="{local:Loc Key=EditorTitleBar.Subtitle}">
            <TitleBar.IconSource><ImageIconSource ImageSource="Assets/icon.png"/></TitleBar.IconSource>
        </TitleBar>
        <Grid Grid.Row="1" Margin="20,12,20,12" ColumnSpacing="20">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="310"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource CardBorder}" Padding="22">
                <Grid>
                    <Rectangle Fill="{ThemeResource SubtleFillColorSecondaryBrush}" RadiusX="14" RadiusY="14"/>
                    <Image x:Name="PreviewImage" Margin="24" Stretch="Uniform"/>
                    <ProgressRing x:Name="PreviewProgress" Width="32" Height="32" IsActive="False"/>
                </Grid>
            </Border>
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="13">
                    <ComboBox x:Name="AspectCombo" Header="{local:Loc Key=EditorAspect.Header}" HorizontalAlignment="Stretch" SelectionChanged="Control_Changed">
                        <ComboBoxItem Tag="original" Content="{local:Loc Key=EditorOriginalRatio.Content}"/><ComboBoxItem Tag="1:1" Content="1 : 1"/><ComboBoxItem Tag="4:3" Content="4 : 3"/><ComboBoxItem Tag="3:4" Content="3 : 4"/><ComboBoxItem Tag="16:9" Content="16 : 9"/><ComboBoxItem Tag="9:16" Content="9 : 16"/>
                    </ComboBox>
                    <StackPanel><TextBlock Text="{local:Loc Key=EditorZoom.Text}"/><Slider x:Name="ZoomSlider" Minimum="1" Maximum="4" StepFrequency="0.05" Value="1" ValueChanged="Control_Changed"/></StackPanel>
                    <StackPanel><TextBlock Text="{local:Loc Key=EditorHorizontal.Text}"/><Slider x:Name="OffsetXSlider" Minimum="-1" Maximum="1" StepFrequency="0.02" Value="0" ValueChanged="Control_Changed"/></StackPanel>
                    <StackPanel><TextBlock Text="{local:Loc Key=EditorVertical.Text}"/><Slider x:Name="OffsetYSlider" Minimum="-1" Maximum="1" StepFrequency="0.02" Value="0" ValueChanged="Control_Changed"/></StackPanel>
                    <StackPanel><TextBlock Text="{local:Loc Key=EditorPadding.Text}"/><Slider x:Name="PaddingSlider" Minimum="0" Maximum="0.35" StepFrequency="0.01" Value="0.06" ValueChanged="Control_Changed"/></StackPanel>
                    <StackPanel><TextBlock Text="{local:Loc Key=EditorCorner.Text}"/><Slider x:Name="CornerSlider" Minimum="0" Maximum="0.5" StepFrequency="0.01" Value="0" ValueChanged="Control_Changed"/></StackPanel>
                    <ToggleSwitch x:Name="RemoveBackgroundToggle" Header="{local:Loc Key=EditorRemoveBackground.Header}" OffContent="{local:Loc Key=EditorRemoveBackground.OffContent}" OnContent="{local:Loc Key=EditorRemoveBackground.OnContent}" Toggled="RemoveBackground_Changed"/>
                    <ComboBox x:Name="RemoveColorCombo" Header="{local:Loc Key=EditorRemoveColor.Header}" HorizontalAlignment="Stretch" IsEnabled="False" SelectionChanged="Control_Changed">
                        <ComboBoxItem Tag="FFFFFFFF" Content="{local:Loc Key=EditorWhite.Content}"/><ComboBoxItem Tag="FF000000" Content="{local:Loc Key=EditorBlack.Content}"/><ComboBoxItem Tag="FF00FF00" Content="{local:Loc Key=EditorGreen.Content}"/><ComboBoxItem Tag="FFFF00FF" Content="{local:Loc Key=EditorMagenta.Content}"/>
                    </ComboBox>
                    <StackPanel><TextBlock Text="{local:Loc Key=EditorTolerance.Text}"/><Slider x:Name="RemoveToleranceSlider" IsEnabled="False" Minimum="0" Maximum="120" StepFrequency="1" Value="24" ValueChanged="Control_Changed"/></StackPanel>
                    <ComboBox x:Name="ShapeCombo" Header="{local:Loc Key=EditorShape.Header}" HorizontalAlignment="Stretch" SelectionChanged="Control_Changed">
                        <ComboBoxItem Tag="none" Content="{local:Loc Key=EditorShapeNone.Content}"/><ComboBoxItem Tag="rounded" Content="{local:Loc Key=EditorShapeRounded.Content}"/><ComboBoxItem Tag="squircle" Content="{local:Loc Key=EditorShapeSquircle.Content}"/><ComboBoxItem Tag="circle" Content="{local:Loc Key=EditorShapeCircle.Content}"/>
                    </ComboBox>
                    <ComboBox x:Name="ColorCombo" Header="{local:Loc Key=EditorBottomColor.Header}" HorizontalAlignment="Stretch" SelectionChanged="Control_Changed">
                        <ComboBoxItem Tag="FF5B6EF5" Content="{local:Loc Key=EditorIndigo.Content}"/><ComboBoxItem Tag="FF167D8D" Content="{local:Loc Key=EditorCyan.Content}"/><ComboBoxItem Tag="FF2E7D57" Content="{local:Loc Key=EditorColorGreen.Content}"/><ComboBoxItem Tag="FFD45D48" Content="{local:Loc Key=EditorCoral.Content}"/><ComboBoxItem Tag="FF20242D" Content="{local:Loc Key=EditorDarkGray.Content}"/><ComboBoxItem Tag="FFF4F5F7" Content="{local:Loc Key=EditorLightGray.Content}"/>
                    </ComboBox>
                </StackPanel>
            </ScrollViewer>
        </Grid>
        <Grid Grid.Row="2" Padding="20,10,20,18">
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{local:Loc Key=EditorLocalOnly.Text}"/>
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8"><Button Content="{local:Loc Key=EditorCancel.Content}" Click="Cancel_Click"/><Button Style="{StaticResource AccentButtonStyle}" Content="{local:Loc Key=EditorSave.Content}" Click="Save_Click"/></StackPanel>
        </Grid>
    </Grid>
</Window>
