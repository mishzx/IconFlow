<Window
    x:Class="IconFlow.QuickChangeWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:IconFlow">
    <Window.SystemBackdrop><MicaBackdrop Kind="BaseAlt"/></Window.SystemBackdrop>
    <Grid x:Name="Root" AllowDrop="True" DragOver="Root_DragOver" Drop="Root_Drop">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TitleBar x:Name="AppTitleBar" Title="{local:Loc Key=QuickTitleBar.Title}">
            <TitleBar.IconSource><ImageIconSource ImageSource="Assets/icon.png"/></TitleBar.IconSource>
        </TitleBar>
        <Border Grid.Row="1" Margin="14,8,14,0" Style="{StaticResource CardBorder}" Padding="12">
            <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="38" Height="38" CornerRadius="9" Background="{ThemeResource AccentFillColorSecondaryBrush}"><FontIcon Glyph="&#xE8B7;" FontSize="19"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock x:Name="TargetName" FontSize="16" FontWeight="SemiBold" Text="{local:Loc Key=QuickReading.Text}"/><TextBlock x:Name="TargetPath" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel><ToggleButton x:Name="PinToggle" Grid.Column="2" Width="36" Height="36" Padding="0" IsChecked="True" Click="PinToggle_Click" ToolTipService.ToolTip="窗口置顶"><FontIcon Glyph="&#xE840;" FontSize="15"/></ToggleButton></Grid>
        </Border>
        <InfoBar x:Name="StatusBar" Grid.Row="2" Margin="16,10,16,0" IsOpen="False" IsClosable="True">
            <InfoBar.ActionButton><Button x:Name="UndoButton" Content="{local:Loc Key=QuickUndo.Content}" Click="Undo_Click"/></InfoBar.ActionButton>
        </InfoBar>
        <Grid Grid.Row="3" Margin="14,9,14,0" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="112"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions><AutoSuggestBox x:Name="SearchBox" QueryIcon="Find" PlaceholderText="{local:Loc Key=QuickSearch.PlaceholderText}" TextChanged="SearchBox_TextChanged"/><ComboBox x:Name="FolderFilter" Grid.Column="1" ItemsSource="{x:Bind FolderChoices}" DisplayMemberPath="Name" SelectionChanged="FolderFilter_SelectionChanged"/><Button Grid.Column="2" Width="36" Padding="0" ToolTipService.ToolTip="管理文件夹"><FontIcon Glyph="&#xE712;" FontSize="14"/><Button.Flyout><MenuFlyout><MenuFlyoutItem Text="{local:Loc Key=QuickNewFolder.Text}" Click="AddFolder_Click"/><MenuFlyoutItem Text="{local:Loc Key=QuickRenameFolder.Text}" Click="RenameCurrentFolder_Click"/></MenuFlyout></Button.Flyout></Button></Grid>
        <Grid Grid.Row="4" Margin="14,9,14,6">
            <GridView x:Name="IconGrid" ItemsSource="{x:Bind Icons}" SelectionChanged="IconGrid_SelectionChanged" SelectionMode="Single" ItemContainerStyle="{StaticResource IconCardItem}">
                <GridView.ItemTemplate><DataTemplate><Border Style="{StaticResource CardBorder}" Width="112" Padding="9" PointerPressed="IconCard_PointerPressed"><Border.ContextFlyout><MenuFlyout><MenuFlyoutItem Text="{local:Loc Key=QuickIconRename.Text}" Tag="{Binding Id}" Click="IconRenameMenu_Click"/><MenuFlyoutItem Text="{local:Loc Key=QuickIconEdit.Text}" Tag="{Binding Id}" Click="IconEditMenu_Click"/><MenuFlyoutItem Text="{local:Loc Key=QuickIconMove.Text}" Tag="{Binding Id}" Click="IconMoveMenu_Click"/><MenuFlyoutItem Text="{Binding FavoriteText}" Tag="{Binding Id}" Click="IconFavoriteMenu_Click"/><MenuFlyoutSeparator/><MenuFlyoutItem Text="{local:Loc Key=QuickIconDelete.Text}" Tag="{Binding Id}" Click="IconDeleteMenu_Click"/></MenuFlyout></Border.ContextFlyout><StackPanel Spacing="6"><Image Source="{Binding Preview}" Width="72" Height="72" Stretch="Uniform"/><TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextAlignment="Center" TextTrimming="CharacterEllipsis"/></StackPanel></Border></DataTemplate></GridView.ItemTemplate>
            </GridView>
            <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10"><FontIcon Glyph="&#xE898;" FontSize="32" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock Text="{local:Loc Key=QuickEmptyTitle.Text}" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{local:Loc Key=QuickEmptySubtitle.Text}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><Button Style="{StaticResource AccentButtonStyle}" Content="{local:Loc Key=QuickImportIcon.Content}" Click="Import_Click"/></StackPanel>
        </Grid>
        <Grid Grid.Row="5" Padding="14,8,14,14" ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Button Content="{local:Loc Key=QuickRestore.Content}" Click="RestoreDefault_Click"/>
            <Button Grid.Column="2" Content="{local:Loc Key=QuickImport.Content}" Click="Import_Click"/>
            <Button Grid.Column="3" Style="{StaticResource AccentButtonStyle}" Content="{local:Loc Key=QuickOpenMain.Content}" Click="OpenMain_Click"/>
        </Grid>
    </Grid>
</Window>
