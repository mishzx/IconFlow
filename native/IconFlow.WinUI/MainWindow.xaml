<Window
    x:Class="IconFlow.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:IconFlow">
    <Window.SystemBackdrop><MicaBackdrop Kind="Base" /></Window.SystemBackdrop>

    <Grid x:Name="Root" AllowDrop="True" DragOver="Root_DragOver" Drop="Root_Drop">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TitleBar x:Name="AppTitleBar" Title="IconFlow" Subtitle="{local:Loc Key=AppTitleBar.Subtitle}">
            <TitleBar.IconSource><ImageIconSource ImageSource="Assets/icon.png" /></TitleBar.IconSource>
        </TitleBar>

        <NavigationView x:Name="NavView" Grid.Row="1" PaneDisplayMode="LeftCompact" CompactPaneLength="48" OpenPaneLength="188"
                        IsPaneOpen="True" IsBackButtonVisible="Collapsed" IsSettingsVisible="True" SelectionChanged="NavView_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="HomeNav" Icon="Home" Content="{local:Loc Key=NavHome.Content}" Tag="home" />
                <NavigationViewItem x:Name="LibraryNav" Icon="Library" Content="{local:Loc Key=NavLibrary.Content}" Tag="library" />
                <NavigationViewItem x:Name="HistoryNav" Icon="Clock" Content="{local:Loc Key=NavHistory.Content}" Tag="history" />
            </NavigationView.MenuItems>
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <InfoBar x:Name="StatusBar" Margin="24,10,24,0" IsOpen="False" IsClosable="True" />
                <Grid Grid.Row="1">
                    <ScrollViewer x:Name="HomePage" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="28,22,28,30" Spacing="18">
                            <Grid>
                                <StackPanel><TextBlock Style="{StaticResource PageHeader}" Text="{local:Loc Key=HomeHeader.Text}"/><TextBlock Margin="0,4,0,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{local:Loc Key=HomeSubtitle.Text}"/></StackPanel>
                                <Button HorizontalAlignment="Right" VerticalAlignment="Center" Click="Undo_Click"><StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE7A7;"/><TextBlock Text="{local:Loc Key=UndoText.Text}"/></StackPanel></Button>
                            </Grid>
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource CardBorder}" MinHeight="210" BorderBrush="{ThemeResource AccentFillColorDefaultBrush}">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                                        <FontIcon Glyph="&#xE8B7;" FontSize="38" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                        <TextBlock FontSize="19" FontWeight="SemiBold" Text="{local:Loc Key=DropTargetTitle.Text}"/>
                                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{local:Loc Key=DropTargetSubtitle.Text}"/>
                                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,5,0,0"><Button Style="{StaticResource AccentButtonStyle}" Content="{local:Loc Key=ChooseFolder.Content}" Click="ChooseFolder_Click"/><Button Content="{local:Loc Key=ChooseShortcut.Content}" Click="ChooseShortcut_Click"/></StackPanel>
                                        <TextBlock x:Name="SelectedTargetText" MaxWidth="500" TextTrimming="CharacterEllipsis" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{local:Loc Key=NoTarget.Text}"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource CardBorder}">
                                    <StackPanel Spacing="8"><TextBlock Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Text="{local:Loc Key=RecentAction.Text}"/><TextBlock x:Name="LastActionName" FontSize="18" FontWeight="SemiBold" Margin="0,22,0,0" Text="{local:Loc Key=NoHistory.Text}" TextWrapping="Wrap"/><TextBlock x:Name="LastActionTime" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{local:Loc Key=AutoBackup.Text}" TextWrapping="Wrap"/><Button Margin="0,18,0,0" HorizontalAlignment="Left" Content="{local:Loc Key=UndoThis.Content}" Click="Undo_Click"/></StackPanel>
                                </Border>
                            </Grid>
                            <Grid Margin="0,4,0,0"><TextBlock Style="{StaticResource SectionHeader}" Text="{local:Loc Key=RecentUsed.Text}"/><Button HorizontalAlignment="Right" Style="{StaticResource AccentButtonStyle}" Click="Import_Click"><StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE710;"/><TextBlock Text="{local:Loc Key=ImportIconText.Text}"/></StackPanel></Button></Grid>
                            <GridView x:Name="RecentGrid" ItemsSource="{x:Bind RecentIcons}" SelectionChanged="IconGrid_SelectionChanged" SelectionMode="Single" ItemContainerStyle="{StaticResource IconCardItem}">
                                <GridView.ItemTemplate><DataTemplate><Border Style="{StaticResource CardBorder}" Width="132" Padding="12"><StackPanel Spacing="7"><Image Source="{Binding Preview}" Width="64" Height="64"/><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Usage}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel></Border></DataTemplate></GridView.ItemTemplate>
                            </GridView>
                        </StackPanel>
                    </ScrollViewer>

                    <Grid x:Name="LibraryPage" Visibility="Collapsed" Margin="28,22,28,24">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="172"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid Grid.ColumnSpan="2"><StackPanel><TextBlock Style="{StaticResource PageHeader}" Text="{local:Loc Key=LibraryHeader.Text}"/><TextBlock Margin="0,4,0,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{local:Loc Key=LibrarySubtitle.Text}"/></StackPanel><Button HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource AccentButtonStyle}" Click="Import_Click"><StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE710;"/><TextBlock Text="{local:Loc Key=ImportText.Text}"/></StackPanel></Button></Grid>
                        <AutoSuggestBox x:Name="SearchBox" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,18,0,14" PlaceholderText="{local:Loc Key=LibrarySearch.PlaceholderText}" TextChanged="SearchBox_TextChanged" QueryIcon="Find"/>
                        <Border Grid.Row="2" Margin="0,0,12,0" Style="{StaticResource CardBorder}" Padding="8">
                            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Button Margin="2" HorizontalAlignment="Stretch" Content="{local:Loc Key=NewFolder.Content}" Click="AddFolder_Click"/><ListView x:Name="FolderList" Grid.Row="1" Margin="0,6,0,0" ItemsSource="{x:Bind IconFolders}" SelectionChanged="FolderList_SelectionChanged" SelectionMode="Single"><ListView.ItemTemplate><DataTemplate><Border Padding="8,7" AllowDrop="True" DragOver="Folder_DragOver" Drop="Folder_Drop"><Border.ContextFlyout><MenuFlyout><MenuFlyoutItem Text="{local:Loc Key=FolderRename.Text}" Tag="{Binding Id}" Click="RenameFolder_Click"/></MenuFlyout></Border.ContextFlyout><Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><FontIcon Glyph="&#xE8B7;" FontSize="15"/><TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="2" Text="{Binding CountText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></Grid></Border></DataTemplate></ListView.ItemTemplate></ListView></Grid>
                        </Border>
                        <GridView x:Name="LibraryGrid" Grid.Row="2" Grid.Column="1" ItemsSource="{x:Bind FilteredIcons}" IsItemClickEnabled="True" ItemClick="LibraryGrid_ItemClick" SelectionMode="Single" ItemContainerStyle="{StaticResource IconCardItem}">
                            <GridView.ItemTemplate><DataTemplate><Border Style="{StaticResource CardBorder}" Width="142" Padding="12" CanDrag="True" DragStarting="IconCard_DragStarting"><Border.ContextFlyout><MenuFlyout><MenuFlyoutItem Text="{local:Loc Key=IconRename.Text}" Tag="{Binding Id}" Click="IconRenameMenu_Click"/><MenuFlyoutItem Text="{local:Loc Key=IconEdit.Text}" Tag="{Binding Id}" Click="IconEditMenu_Click"/><MenuFlyoutItem Text="{local:Loc Key=IconMove.Text}" Tag="{Binding Id}" Click="IconMoveMenu_Click"/><MenuFlyoutItem Text="{Binding FavoriteText}" Tag="{Binding Id}" Click="IconFavoriteMenu_Click"/><MenuFlyoutSeparator/><MenuFlyoutItem Text="{local:Loc Key=IconDelete.Text}" Tag="{Binding Id}" Click="IconDeleteMenu_Click"/></MenuFlyout></Border.ContextFlyout><Grid><StackPanel Spacing="7"><Image Source="{Binding Preview}" Width="74" Height="74" Stretch="Uniform"/><Grid Margin="0,1,20,0"><TextBlock Text="{Binding Name}" Visibility="{Binding NameVisibility}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBox Text="{Binding Name, Mode=OneWay}" Visibility="{Binding EditorVisibility}" MinWidth="96" Padding="5,2" Tag="{Binding Id}" LostFocus="RenameBox_LostFocus" KeyDown="RenameBox_KeyDown"/></Grid><TextBlock Text="{Binding Source}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel><Button HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="30" Height="30" Padding="0" Background="Transparent" Tag="{Binding Id}" Click="Favorite_Click"><FontIcon Glyph="{Binding FavoriteGlyph}" FontSize="14"/></Button></Grid></Border></DataTemplate></GridView.ItemTemplate>
                        </GridView>
                    </Grid>

                    <Grid x:Name="HistoryPage" Visibility="Collapsed" Margin="28,22,28,24">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <StackPanel><TextBlock Style="{StaticResource PageHeader}" Text="{local:Loc Key=HistoryHeader.Text}"/><TextBlock Margin="0,4,0,14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{local:Loc Key=HistorySubtitle.Text}"/></StackPanel>
                        <ListView x:Name="HistoryList" Grid.Row="1" ItemsSource="{x:Bind HistoryGroups}" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Expander IsExpanded="False" HorizontalAlignment="Stretch">
                                        <Expander.Header>
                                            <Grid Padding="8" ColumnSpacing="12" MinWidth="720">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <Border Width="48" Height="48" CornerRadius="10" Background="{ThemeResource SubtleFillColorSecondaryBrush}"><Grid><FontIcon Glyph="&#xE8B7;" FontSize="22" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><Image Source="{Binding LatestPreview}" Width="42" Height="42" Stretch="Uniform"/></Grid></Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="{Binding Path}" MaxWidth="430" TextTrimming="CharacterEllipsis" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock Text="{Binding Summary}" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/></StackPanel>
                                                <Button Grid.Column="2" Tag="{Binding Path}" Click="HistoryOpen_Click"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE838;"/><TextBlock Text="{local:Loc Key=OpenLocationText.Text}"/></StackPanel></Button>
                                                <Button Grid.Column="3" Tag="{Binding LatestUndoableId}" IsEnabled="{Binding CanUndo}" Click="HistoryUndo_Click"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE7A7;"/><TextBlock Text="{local:Loc Key=UndoRecentText.Text}"/></StackPanel></Button>
                                            </Grid>
                                        </Expander.Header>
                                        <ItemsControl ItemsSource="{Binding Items}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource CardBorder}" Margin="8,4,8,8" Padding="12">
                                                        <Grid ColumnSpacing="10">
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="66"/><ColumnDefinition Width="22"/><ColumnDefinition Width="66"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                            <StackPanel Spacing="3"><TextBlock Text="{local:Loc Key=BeforeText.Text}" FontSize="10" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><Border Width="58" Height="58" CornerRadius="9" Background="{ThemeResource SubtleFillColorSecondaryBrush}"><Grid><FontIcon Glyph="&#xE8B7;" FontSize="20" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><Image Source="{Binding BeforePreview}" Width="52" Height="52" Stretch="Uniform"/></Grid></Border></StackPanel>
                                                            <FontIcon Grid.Column="1" Glyph="&#xE72A;" FontSize="13" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                            <StackPanel Grid.Column="2" Spacing="3"><TextBlock Text="{local:Loc Key=AfterText.Text}" FontSize="10" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><Border Width="58" Height="58" CornerRadius="9" Background="{ThemeResource SubtleFillColorSecondaryBrush}"><Grid><FontIcon Glyph="&#xE8B7;" FontSize="20" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><Image Source="{Binding AfterPreview}" Width="52" Height="52" Stretch="Uniform"/></Grid></Border></StackPanel>
                                                            <StackPanel Grid.Column="3" Margin="8,0" VerticalAlignment="Center"><TextBlock Text="{Binding Time}" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="{Binding Action}"/><TextBlock Text="{Binding Status}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/></StackPanel></StackPanel>
                                                            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8"><Button Tag="{Binding Path}" Content="{local:Loc Key=OpenLocationButton.Content}" Click="HistoryOpen_Click"/><Button Tag="{Binding Record.Id}" Content="{local:Loc Key=UndoChangeButton.Content}" IsEnabled="{Binding CanUndo}" Click="HistoryUndo_Click"/></StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Expander>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>

                    <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="28,22,28,30" MaxWidth="720" HorizontalAlignment="Left" Spacing="14">
                            <TextBlock Style="{StaticResource PageHeader}" Text="{local:Loc Key=SettingsHeader.Text}"/>
                            <Border Style="{StaticResource CardBorder}"><StackPanel Spacing="14"><TextBlock Style="{StaticResource SectionHeader}" Text="{local:Loc Key=AppearanceHeader.Text}"/><StackPanel Orientation="Horizontal" Spacing="12"><ComboBox x:Name="ThemeCombo" Header="{local:Loc Key=ThemeCombo.Header}" Width="190" SelectionChanged="ThemeCombo_SelectionChanged"><ComboBoxItem Tag="system" Content="{local:Loc Key=ThemeSystem.Content}"/><ComboBoxItem Tag="light" Content="{local:Loc Key=ThemeLight.Content}"/><ComboBoxItem Tag="dark" Content="{local:Loc Key=ThemeDark.Content}"/></ComboBox><ComboBox x:Name="LanguageCombo" Header="{local:Loc Key=LanguageCombo.Header}" Width="220" ItemsSource="{x:Bind LanguageOptions}" DisplayMemberPath="Name" SelectionChanged="LanguageCombo_SelectionChanged"/></StackPanel></StackPanel></Border>
                            <Border Style="{StaticResource CardBorder}"><StackPanel Spacing="16"><TextBlock Style="{StaticResource SectionHeader}" Text="{local:Loc Key=IntegrationHeader.Text}"/><ToggleSwitch x:Name="ContextMenuToggle" Header="{local:Loc Key=CompatMenu.Header}" OffContent="{local:Loc Key=CompatMenu.OffContent}" OnContent="{local:Loc Key=CompatMenu.OnContent}" Toggled="ContextMenuToggle_Toggled"/><TextBlock x:Name="ModernMenuStatusText" Margin="0,-8,0,0" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{local:Loc Key=ModernStatus.Text}" TextWrapping="Wrap"/><Button HorizontalAlignment="Left" Content="{local:Loc Key=InstallModernMenu.Content}" Click="InstallModernMenu_Click"/><ToggleSwitch x:Name="StartToggle" Header="{local:Loc Key=StartToggle.Header}" OffContent="{local:Loc Key=StartToggle.OffContent}" OnContent="{local:Loc Key=StartToggle.OnContent}" Toggled="StartToggle_Toggled"/><TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{local:Loc Key=PermissionsNote.Text}" TextWrapping="Wrap"/></StackPanel></Border>
                            <Border Style="{StaticResource CardBorder}"><StackPanel Spacing="10"><TextBlock Style="{StaticResource SectionHeader}" Text="{local:Loc Key=StorageHeader.Text}"/><TextBlock x:Name="IconStoragePathText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/><Button HorizontalAlignment="Left" Content="{local:Loc Key=ChangeMigrate.Content}" Click="ChangeStorage_Click"/><TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{local:Loc Key=MigrateNote.Text}" TextWrapping="Wrap"/></StackPanel></Border>
                            <Border Style="{StaticResource CardBorder}"><StackPanel Spacing="8"><TextBlock Style="{StaticResource SectionHeader}" Text="{local:Loc Key=DataHeader.Text}"/><TextBlock x:Name="DataPathText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/><TextBlock Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Text="{local:Loc Key=LocalMode.Text}"/></StackPanel></Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
